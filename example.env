OPENALEX_CACHE_PATH="~/.cache/raqindex"
REDIS_URL=redis://127.0.0.1:6379/0
OPENALEX_CACHE_KEY_PREFIX=raqindex
# Optional: increase the default 10 MiB per-response Redis cache limit to 64 MiB.
# OPENALEX_CACHE_MAX_RESPONSE_BYTES=67108864
# Leave REDIS_URL unset or empty to use SQLite; inside Compose use redis://redis:6379/0.
OPENALEX_API_KEY=<your_openalex_api_key>
OPENALEX_API_URL=https://api.openalex.org
OPENALEX_CACHE_DB_PATH = "hishel/openalex_cache.db"  # Path to the SQLite database for caching
OPENALEX_CACHE_TTL = "1d"  # Time-to-live for cache entries, e.g., "1d" for one day, "12h" for twelve hours
OPENALEX_SCHEMA_PATH="schemas"
OPENALEX_OQO_SPEC_FILE_PATH="oqo_spec.json"
OPENALEX_OPENALEX_SPEC_FILE_PATH="openalex_spec.json"
OPENALEX_OQO_MODEL_MAP_FILE_PATH="oqo_model_map.json"
OPENALEX_OPENALEX_MODEL_MAP_FILE_PATH="openalex_model_map.json"
OPENALEX_ENDPOINTS_FILE_PATH="openalex_endpoints.json"
EMAIL=<your_email>
